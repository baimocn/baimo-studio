# baimo Studio - Rust Backend Configuration
# Copy this file to .env and fill in the required values.

# ── Required ───────────────────────────────────────────────────────────────
# Agnes AI API key (required)
AGNES_API_KEY=

# ── Agnes API ──────────────────────────────────────────────────────────────
# Agnes API base URL (default: https://apihub.agnes-ai.com)
AGNES_API_BASE=https://apihub.agnes-ai.com

# ── Database ───────────────────────────────────────────────────────────────
# SQLite database URL (default: sqlite:./data/agnes.db)
DATABASE_URL=sqlite:./data/agnes.db

# ── Server ─────────────────────────────────────────────────────────────────
# Server port (default: 5180)
SERVER_PORT=5180

# CORS allowed origins (comma-separated)
# Include your frontend dev server and production domain
CORS_ORIGINS=http://localhost:5180,http://localhost:5188

# ── Authentication ─────────────────────────────────────────────────────────
# JWT secret key (leave empty to auto-generate ephemeral key on startup)
# IMPORTANT: Set a stable value in production for persistent sessions
JWT_SECRET=
# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256
# JWT token expiry in days (default: 30)
JWT_EXPIRE_DAYS=30

# ── Limits ─────────────────────────────────────────────────────────────────
# Max upload file size in bytes (default: 20971520 = 20MB)
MAX_UPLOAD_BYTES=20971520
# Max download file size in bytes (default: 104857600 = 100MB)
MAX_DOWNLOAD_BYTES=104857600
# Rate limit: max requests per minute per IP (default: 60)
RATE_LIMIT_PER_MINUTE=60

# ── Logging ────────────────────────────────────────────────────────────────
# Log level: trace, debug, info, warn, error (default: info)
# RUST_LOG=info
